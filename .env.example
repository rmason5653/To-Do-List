# ---------------------------------------------------------------------------
# Database (Supabase) - REQUIRED
# Project Settings -> API in your Supabase dashboard.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App access gate - REQUIRED for a deployed (public) URL
# A single password you type once to open the app. Leave blank to disable.
# ---------------------------------------------------------------------------
APP_PASSWORD=

# ---------------------------------------------------------------------------
# Slack two-way sync - OPTIONAL (the app works fully without it)
# SLACK_TOKEN: a User OAuth token (xoxp-...) for a Slack app with scopes
#   lists:read, lists:write, users:read, users:read.email
# SLACK_LIST_ID: the Ops List file id (default below is the current Ops List)
# SLACK_SIGNING_SECRET: only needed for instant inbound webhook events
# ---------------------------------------------------------------------------
SLACK_TOKEN=
SLACK_LIST_ID=F09FSF0BD89
SLACK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Cron protection - OPTIONAL
# If set, the daily Vercel cron must present this as a Bearer token.
# ---------------------------------------------------------------------------
CRON_SECRET=
