# ---------------------------------------------------------------------------
# Database (Supabase) - REQUIRED
# Project Settings -> API in your Supabase dashboard.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Team access gate - set this in production
# One shared password the whole team types once to open the app. Also acts as
# the admin bootstrap while you set up per-user accounts. Blank = open (dev).
# ---------------------------------------------------------------------------
APP_PASSWORD=

# ---------------------------------------------------------------------------
# Per-user login signing key - set in production
# Any long random string. Signs the per-user session cookies for invite-link
# login. Falls back to APP_PASSWORD if unset.
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Email (Resend) - OPTIONAL, enables auto-sending invite links
# Free tier at resend.com. Without it, invites still work via the manual
# Copy / Text buttons on the Team screen.
#   RESEND_API_KEY: from your Resend dashboard
#   EMAIL_FROM:     verified sender, e.g. "Mason Homes Par <par@livemasonhomes.com>"
#                   (defaults to Resend's test sender if unset)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
