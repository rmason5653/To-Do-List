# ---------------------------------------------------------------------------
# Database (Supabase) - REQUIRED
# Project Settings -> API in your Supabase dashboard.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Team access gate - set this in production
# One shared password the whole team types once to open the app (works for
# cleaners with no account). Leave blank to run fully open (local dev).
# ---------------------------------------------------------------------------
APP_PASSWORD=
