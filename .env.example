# ---------------------------------------------------------------------------
# Database (Supabase) - REQUIRED
# Project Settings -> API in your Supabase dashboard.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App access gate - REQUIRED for a deployed (public) URL
# A single shared password the team types once to open the app. The whole
# team can see the inventory, so this is a light gate, not per-user auth.
# Leave blank to disable (local development only).
# ---------------------------------------------------------------------------
APP_PASSWORD=
